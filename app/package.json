{
  "name": "ilanzou-disk",
  "version": "0.1.0",
  "private": true,
  "main": "build/main/index.js",
  "description": "蓝奏云优享版第三方客户端",
  "author": {
    "name": "SiqYin",
    "url": "https://github.com/SiqYin"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "electron-is": "^3.0.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^24.8.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "productName": "蓝奏云优享盘",
    "copyright": "https://github.com/SiqYin/ilanzou-disk",
    "appId": "com.siqyin.ilanzou",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "SiqYin",
        "repo": "ilanzou-disk"
      }
    ],
    "files": [
      "build"
    ],
    "extends": null,
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "ilanzou-${version}-x64-win.${ext}"
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w"
  }
}
